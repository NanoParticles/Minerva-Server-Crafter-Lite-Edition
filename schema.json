{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"Instance Name",
		"addon_listing",
		"server_type",
		"server_type_version",
		"minecraft_version",
		"minecraft_server_properties"
	],
	"properties": {
		"Instance Name": {
			"type": "string"
		},
		"addon_listing": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"server_type": {
			"type": "string"
		},
		"custom_jar_data": {
			"type": "object",
			"properties": {
				"logic_behavior": {
					"type": "string",
					"enum": ["modding", "plugins", "both", "neither"]
				},
				"ServerHasParentDirectory": {
					"type": "boolean"
				},
				"server_path": {
					"type": "string"
				}
			},
			"if": {
				"properties": {
					"ServerHasParentDirectory": { "const": true }
				},
				"required": ["ServerHasParentDirectory"]
			},
			"then": {
				"required": ["server_path"]
			},
			"required": ["logic_behavior"]
		},
		"server_type_version": {
			"type": "string"
		},
		"minecraft_version": {
			"type": "string"
		},
		"minecraft_server_properties": {
			"type": "object",
			"properties": {}
		}
	},
	"if": {
		"properties": {
			"server_type": { "const": "custom" }
		},
		"required": ["server_type"]
	},
	"then": {
		"required": ["custom_jar_data"]
	}
}
